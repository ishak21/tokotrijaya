# ==========================================
# TokoTriJaya - Environment Variables
# ==========================================
# Copy file ini ke .env lalu isi valuenya:
#   cp .env.example .env

# Port server
PORT=8000

# Mode: development atau production
NODE_ENV=production

# Secret key untuk session login
# Generate random: openssl rand -hex 32
SESSION_SECRET= isi-dengan-random-string-anda
